# ─────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=https://factor.onrender.com
CORS_ORIGIN=https://factor.onrender.com

# ─────────────────────────────────────────────
# SUPABASE
# ─────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.yyyyy
SUPABASE_STORAGE_BUCKET=factor-media

# ─────────────────────────────────────────────
# AUTH / SESSIONS
# ─────────────────────────────────────────────
JWT_SECRET=change_me_to_64_random_chars
JWT_EXPIRES_IN=30d
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ─────────────────────────────────────────────
# EMAIL (OTP delivery)
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourmail@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="Factor <yourmail@gmail.com>"

# ─────────────────────────────────────────────
# DEVELOPER / OWNER
# ─────────────────────────────────────────────
DEVELOPER_EMAILS=artemnef0r@icloud.com

# ─────────────────────────────────────────────
# RATE LIMITS
# ─────────────────────────────────────────────
RL_MESSAGES_PER_MIN=30
RL_AUTH_ATTEMPTS=5
RL_AUTH_WINDOW_MIN=15

# ─────────────────────────────────────────────
# MEDIA LIMITS (bytes)
# ─────────────────────────────────────────────
MAX_PHOTO_BYTES=10485760
MAX_VIDEO_BYTES=52428800
MAX_VOICE_BYTES=5242880
MAX_MUSIC_BYTES=20971520
MAX_VIDEO_DURATION_SEC=60

# ─────────────────────────────────────────────
# RULES
# ─────────────────────────────────────────────
BIO_MAX_CHARS=80
USERNAME_MIN=5
USERNAME_MAX=32
AGE_MIN=1
AGE_MAX=100
CHAT_HARD_DELETE_DAYS=31
MESSAGE_DELETE_HOURS=72
GROUP_MAX_MEMBERS=100

# ─────────────────────────────────────────────
# MUSIC COOLDOWNS (hours, after rejection #N)
# ─────────────────────────────────────────────
MUSIC_COOLDOWN_1_H=24
MUSIC_COOLDOWN_2_H=72
MUSIC_COOLDOWN_3_H=168
